# ── TaleLah Environment Configuration ──────────────────────────────────────
# Copy this to .env and fill in real values.
# NEVER commit .env — only commit .env.example.

# ── App ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-random-string

# ── Database (Neon — serverless PostgreSQL) ────────────────────────────────
# Get from: https://console.neon.tech/ → New Project → copy connection string
# A postgresql:// URL turns persistence ON (state survives restarts/redeploys).
# Anything else (or unset) → memory-only mode, works out of the box.
# DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Alibaba Cloud — Qwen (LLM + Vision) ───────────────────────────────────
# Get from: https://dashscope.console.aliyun.com/apiKey (workspace-specific key: sk-ws-...)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# International endpoint (Singapore region). Use /compatible-mode/v1 for OpenAI-compatible API.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
QWEN_VL_MODEL=qwen-vl-max

# ── Sarvam AI — Tamil ASR + TTS ───────────────────────────────────────────
# Get from: https://playground.sarvam.ai/ (sign up → API keys)
SARVAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Cloud — Malay ASR + TTS ────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Create a service account → download JSON key
GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
# Or path to key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── ElevenLabs — P1 voice clone (optional for hackathon) ──────────────────
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudflare R2 (Object Storage — media/photos) ──────────────────────────
# Get from: https://dash.cloudflare.com/ → R2 → Create bucket → API tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=talelah-media
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
# Public URL (if custom domain or public bucket):
# R2_PUBLIC_URL=https://media.talelah.app

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://talelah.app"]

# ── Deployment URLs ───────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
