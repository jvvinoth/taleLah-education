---
// Mina the Myna — the real brand mascot. Previously this was a rough inline
// SVG approximation; it now uses the actual character art (background removed,
// so it sits on the cream and the dark bands alike).
interface Props {
  size?: number;
  /** Kept for API compatibility with the old inline mark. */
  detailed?: boolean;
}
const { size = 30 } = Astro.props;
---

<span class="mina" style={`--s:${size}px`} aria-hidden="true">
  <img src="/mina.png" alt="" width={size} height={size} loading="eager" decoding="async" />
</span>

<style>
  .mina {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--s);
    height: var(--s);
    flex: 0 0 auto;
  }
  .mina img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Lifts the character off the page the way the 3D art expects. */
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.18));
  }
</style>
