---
// Mina the Myna — brand mark, drawn inline so it inherits theme colours.
interface Props {
  size?: number;
  detailed?: boolean;
}
const { size = 30, detailed = true } = Astro.props;
---

<span class="mina" aria-hidden="true">
  <svg width={size} height={size} viewBox="0 0 40 40">
    <ellipse cx="20" cy="23" rx="13" ry="12.5" fill="var(--navy)"></ellipse>
    <circle cx="20" cy="13" r="8.5" fill="var(--navy)"></circle>
    {
      detailed && (
        <path
          d="M14 6 q2 -4 4 0 q2 -4 4 0"
          fill="none"
          stroke="var(--navy)"
          stroke-width="2.4"
          stroke-linecap="round"
        />
      )
    }
    <circle cx="17.5" cy="12.5" r="3" fill="var(--yellow)"></circle>
    {detailed && <circle cx="18" cy="12.7" r="1.4" fill="#fff" />}
    {detailed && <circle cx="18.3" cy="12.7" r=".7" fill="var(--navy)" />}
    <path d="M23 13 l5 1.5 -5 1.5 z" fill="var(--yellow)"></path>
    <path
      d="M13 26 q7 4 14 0"
      fill="none"
      stroke="var(--teal)"
      stroke-width="3"
      stroke-linecap="round"></path>
  </svg>
</span>
