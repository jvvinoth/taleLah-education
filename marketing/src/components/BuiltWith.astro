---
// Built with — Qoder + Alibaba Cloud Qwen strip (hackathon credibility).
import type { SiteContent } from '../i18n';
interface Props { t: SiteContent }
const { t } = Astro.props;
---

<section class="builtwith">
  <div class="wrap reveal">
    <div class="eyebrow" style="justify-content:center">{t.builtWith.eyebrow}</div>
    <h2 style="margin-top:14px;font-size:clamp(22px,3vw,32px)">{t.builtWith.title}</h2>
    <p class="lede" style="margin:14px auto 0">{t.builtWith.lede}</p>
    <div class="logos"><span>🛠 <b>Qoder</b></span><span>☁ <b>Alibaba Cloud Qwen</b></span></div>
  </div>
</section>
